                 '((0 . 10) (1 . 20))))
  (should (equal (lg-iset lg-indexed-vector 0 [1 2 3]) [0 0 0]))
  (should (equal (lg-iover lg-indexed-vector (lambda (i x) (+ i x)) [10 10])
