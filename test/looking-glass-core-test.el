(ert-deftest lg-either-core-and-prisms ()
  (should (lg-either-p (lg-left 1)))
  (should (lg-either-p (lg-right nil)))
  (should-not (lg-either-p 42))
  (should (= (lg-either-value (lg-left 5)) 5))

  (should (equal (lg-preview lg-left-o (lg-left 10)) (lg-just 10)))
  (should (equal (lg-preview lg-left-o (lg-left nil)) (lg-just nil)))
  (should (equal (lg-preview lg-left-o (lg-right 10)) lg-nothing))
  (should (equal (lg-review lg-left-o 7) (lg-left 7)))
  (should (equal (lg-over lg-left-o (lambda (x) (+ x 1)) (lg-left 2)) (lg-left 3)))
  (should (equal (lg-over lg-left-o (lambda (x) (+ x 1)) (lg-right 2)) (lg-right 2)))

  (should (equal (lg-preview lg-right-o (lg-right 10)) (lg-just 10)))
  (should (equal (lg-preview lg-right-o (lg-right nil)) (lg-just nil)))
  (should (equal (lg-preview lg-right-o (lg-left 10)) lg-nothing))
  (should (equal (lg-review lg-right-o 7) (lg-right 7)))
  (should (equal (lg-over lg-right-o (lambda (x) (+ x 1)) (lg-right 2)) (lg-right 3)))
  (should (equal (lg-over lg-right-o (lambda (x) (+ x 1)) (lg-left 2)) (lg-left 2))))

(ert-deftest lg-preview-disambiguates-present-nil ()
