(ert-deftest lg-either-prisms-reject-non-either-values ()
  (should (equal (lg-preview lg-left-o 5) lg-nothing))
  (should (equal (lg-preview lg-right-o "hi") lg-nothing))
  (should (equal (lg-over lg-right-o #'1+ 5) 5))
  (should-not (lg-left-p 5))
  (should-not (lg-right-p "hi")))

(ert-deftest lg-review-propagates-builder-errors ()
  ;; A builder's own validation error must not be masked as a
  ;; capability error.
  (let ((err (should-error (lg-review lg-number-string "not-a-number"))))
    (should-not (eq (car err) 'lg-unsupported-capability)))
  ;; A genuine capability gap signals `lg-unsupported-capability'.
  (should-error (lg-review lg-list '(1 2 3))
                :type 'lg-unsupported-capability)
  (should-error (lg-view (lg-re lg-list) 5)
                :type 'lg-unsupported-capability))

(ert-deftest lg-clone-functions-preserve-behavior ()
  (let ((iso (lg-clone-iso lg-list->vector)))
    (should (equal (lg-view iso '(1 2)) [1 2]))
    (should (equal (lg-review iso [1 2]) '(1 2))))
  (let ((lens (lg-clone-lens lg-car)))
    (should (= (lg-view lens '(1 . 2)) 1))
    (should (equal (lg-set lens 9 '(1 . 2)) '(9 . 2))))
  (let ((prism (lg-clone-prism lg-number-string)))
    (should (equal (lg-preview prism "42") (lg-just 42)))
    (should (equal (lg-preview prism "x") lg-nothing))
    (should (equal (lg-review prism 42) "42")))
  (let ((affine (lg-clone-affine (lg-plist-key :name))))
    (should (equal (lg-preview affine '(:name "Ada")) (lg-just "Ada")))
    (should (equal (lg-set affine "Grace" '(:name "Ada")) '(:name "Grace")))
    (should (equal (lg-set affine "X" '(:other 1)) '(:other 1))))
  (let ((affine (lg-clone-affine (lg-compose lg-car lg-non-nil))))
    (should (equal (lg-preview affine '(1 . 2)) (lg-just 1)))
    (should (equal (lg-preview affine '(nil . 2)) lg-nothing))
    (should (equal (lg-set affine 9 '(1 . 2)) '(9 . 2))))
  (let ((traversal (lg-clone-traversal lg-list)))
    (should (equal (lg-over traversal #'1+ '(1 2 3)) '(2 3 4))))
  (let ((review (lg-clone-review lg-number-string)))
    (should (equal (lg-review review 42) "42"))))

(ert-deftest lg-keyed-optics-reject-non-keyed-lists ()
