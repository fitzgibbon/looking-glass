(ert-deftest lg-prism-non-nil ()
  (let ((optic lg-non-nil))
    (should (equal (lg-preview optic 42) (lg-just 42)))
    (should (equal (lg-review optic 42) 42))
    (should (equal (lg-preview optic nil) lg-nothing))
    (should-not (lg-has optic nil))))

(ert-deftest lg-bool-and-unbool-helpers ()
  (should (eq (lg-bool-value lg-true) t))
  (should (eq (lg-bool-value lg-false) nil))
  (should (eq (lg-bool t) lg-true))
  (should (eq (lg-bool nil) lg-false))
  (should (eq (lg-view lg-unbool lg-true) t))
  (should (eq (lg-view lg-unbool lg-false) nil))
  (should (eq (lg-review lg-unbool t) lg-true))
  (should (eq (lg-review lg-unbool nil) lg-false))
  (should (eq (lg-view lg-not lg-true) lg-false))
  (should (eq (lg-view lg-not lg-false) lg-true))
  (should (eq (lg-view lg-not t) nil))
  (should (eq (lg-view lg-not nil) t))
  (should (eq (lg-review lg-not lg-true) lg-false))
  (should (eq (lg-review lg-not t) nil))
  (should-error (lg-view lg-not 'nope))
  (should-error (lg-bool-value 'nope))
  (should-error (lg-bool 1)))

(ert-deftest lg-review-support ()
  (let* ((just lg-just-o)
         (iso (lg-iso #'number-to-string #'string-to-number))
         (composed (lg-compose just iso)))
    (should (equal (lg-review just 7) '(lg-just . 7)))
    (should (equal (lg-review iso "42") 42))
    (should (equal (lg-review composed "9") '(lg-just . 9)))
    (should-error (lg-review lg-list 1))))

(ert-deftest lg-reverse-reviewed-optics ()
  (let* ((iso (lg-iso #'number-to-string #'string-to-number))
         (reversed (lg-re iso))
         (reversed-lens (lg-re lg-car))
         (reversed-prism (lg-re lg-non-nil)))
    (should (equal (lg-view reversed "42") 42))
    (should (equal (lg-review reversed 7) "7"))
    (should (equal (lg-over reversed (lambda (n) (+ n 1)) "41") "42"))
    (should (equal (lg-view reversed-lens 7) '(7)))
    (should (equal (lg-review reversed-lens '(7 . 9)) 7))
    (should (equal (lg-view reversed-prism 42) 42))
    (should (equal (lg-review reversed-prism 42) 42))
    (should-error (lg-view (lg-re lg-list) '(1 2 3)))))

